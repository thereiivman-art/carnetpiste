rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // email_verified is required too: Firebase Auth lets anyone register an
    // email they don't own until it's confirmed, so the address alone isn't
    // proof of identity.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'germainxav@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Pseudos are the identity key of this whole app (ownership, team
    // leadership...), so they have to be unique: names/{lowercased pseudo}
    // holds the claiming account's uid, and a users doc may only carry a
    // pseudo whose names doc (checked as it will be AFTER the same batch,
    // since signup/rename write both together) belongs to its own uid.
    function nameKey(n) { return n.lower(); }
    function ownsNameAfter(n) {
      return existsAfter(/databases/$(database)/documents/names/$(nameKey(n)))
        && getAfter(/databases/$(database)/documents/names/$(nameKey(n))).data.uid == request.auth.uid;
    }
    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // A chrono belongs to the pilote whose name it carries -- neither an
    // accompagnant nor an organisateur account ever owns one, whatever its
    // name field says (neither actually rides).
    function ownsChrono(riderValue) {
      return myRole() != 'accompagnant' && myRole() != 'organisateur' && myName() == riderValue;
    }
    // Team membership docs are keyed teamId_name (deterministic id, no
    // query needed to check one) -- see teamMembers below.
    function isTeamLeader(teamId) {
      return exists(/databases/$(database)/documents/teamMembers/$(teamId + '_' + myName()))
        && get(/databases/$(database)/documents/teamMembers/$(teamId + '_' + myName())).data.role == 'leader';
    }
    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/teamMembers/$(teamId + '_' + myName()));
    }
    // 'leaders' (default, via the map's own fallback) or 'members' -- who
    // may post to teamFeed; a leader can always post regardless.
    function teamPostPolicy(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.get('postPolicy', 'leaders');
    }
    // For a map field updated one person's own key at a time (a poll vote,
    // an emoji reaction) -- true only if the sole key that changed between
    // before/after is the caller's own name, so nobody can touch another
    // member's vote/reaction.
    function onlyOwnKeyChanged(beforeMap, afterMap) {
      return afterMap.diff(beforeMap).affectedKeys().hasOnly([myName()]);
    }
    // Generic self-rename support for every plain-id collection that
    // carries a name-bearing field (friendRequests.from/to, follows.
    // follower/followee, teamFeed.author, ...): the field can only be
    // rewritten by the doc's proven owner (its matching <field>Uid,
    // unforgeable, stored at creation) to their own current name, never
    // to an arbitrary value -- prevents both "stuck under the old name
    // after a rename" and "rename someone else's field to spoof them".
    // canBackfillUid separately lets a still-not-yet-renamed owner add
    // their own uid to a doc that predates uid tracking (proven simply by
    // the field still matching their current name), so a *future* rename
    // has something to migrate from -- same two-step shape as
    // teamMembers' own uid backfill/migration below.
    function canRenameField(res, field, uidField) {
      return res.data.get(uidField, null) == request.auth.uid
        && request.resource.data.diff(res.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == myName();
    }
    function canBackfillUid(res, nameField, uidField) {
      return res.data[nameField] == myName()
        && request.resource.data.diff(res.data).affectedKeys().hasOnly([uidField])
        // Absent OR explicitly null both count as "not backfilled yet" --
        // some docs store an explicit null (e.g. an invite target whose
        // uid wasn't resolvable at send time) rather than omitting the
        // key, which .hasAny() alone would treat as already set.
        && res.data.get(uidField, null) == null;
    }
    function hasAcceptedTeamInvite(teamId) {
      return exists(/databases/$(database)/documents/teamInvites/$(teamId + '_' + myName()))
        && get(/databases/$(database)/documents/teamInvites/$(teamId + '_' + myName())).data.status == 'accepted';
    }
    // A Team leader (an organisateur running a team of pilotes, typically)
    // can also enter a chrono for a teammate -- the session then carries
    // that team's id so this can be checked without a query (rules can
    // only do point lookups), and both riderValue and the id must belong
    // to the same team on the leader's side.
    function ownsChronoViaTeam(riderValue, teamId) {
      return teamId != null && isTeamLeader(teamId)
        && exists(/databases/$(database)/documents/teamMembers/$(teamId + '_' + riderValue));
    }
    // A Team Event (events/{id}.teamId set) is "owned" by that Team's
    // leader(s) -- the club-adoption pitch is that a chrono logged under
    // one of their events can be certified as genuine, so only the
    // leader of the event's own Team may ever flip that flag.
    function isOrganizerOfLinkedEvent(eventId) {
      return eventId != null
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.get('teamId', null) != null
        && isTeamLeader(get(/databases/$(database)/documents/events/$(eventId)).data.teamId);
    }
    // Only the two sides of an *accepted* coachRequests doc may message
    // each other in it (see coachMessages below) -- pending or already
    // ended relationships don't get a live thread.
    function isPartyToCoachRequest(requestId) {
      return exists(/databases/$(database)/documents/coachRequests/$(requestId))
        && get(/databases/$(database)/documents/coachRequests/$(requestId)).data.status == 'accepted'
        && (get(/databases/$(database)/documents/coachRequests/$(requestId)).data.from == myName()
            || get(/databases/$(database)/documents/coachRequests/$(requestId)).data.to == myName());
    }

    // A user's own profile has to be writable right after signup, before
    // there's been time to verify anything -- no email_verified check here.
    // `certified`/`personality`/`pro` are trust badges the admin grants,
    // not the account itself -- a self-write (uid == userId) may set every
    // other field freely, but can never flip any of those three, on
    // create or update; only isAdmin() can (see renderAccountManagerPanel
    // and the admin's own self-badges in Mon profil -- the admin writing
    // their own doc still goes through the isAdmin() branch below, so
    // they can flip their own badges same as anyone else's).
    match /users/{userId} {
      // Own profile readable before the email is confirmed (the app loads
      // it right after signup); everyone else's only once verified.
      allow read: if verified() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
        && ownsNameAfter(request.resource.data.name)
        && request.resource.data.get('certified', false) == false
        && request.resource.data.get('personality', false) == false
        && request.resource.data.get('pro', false) == false
        && request.resource.data.get('organizer', false) == false
        && request.resource.data.get('coach', false) == false
        && request.resource.data.get('photographer', false) == false;
      // A pseudo change is capped to once every 30 days server-side (not
      // just a client-side warning) -- lastNameChangeAt is stamped with
      // request.time on every actual rename (see saveProfile), never
      // client-supplied, so this can't be bypassed by lying about the
      // previous value.
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId
          && request.resource.data.get('certified', false) == resource.data.get('certified', false)
          && request.resource.data.get('personality', false) == resource.data.get('personality', false)
          && request.resource.data.get('pro', false) == resource.data.get('pro', false)
          && request.resource.data.get('organizer', false) == resource.data.get('organizer', false)
          && request.resource.data.get('coach', false) == resource.data.get('coach', false)
          && request.resource.data.get('photographer', false) == resource.data.get('photographer', false)
          && (request.resource.data.name == resource.data.name
              || (request.time > resource.data.get('lastNameChangeAt', timestamp.date(1970, 1, 1)) + duration.value(30, 'd')
                  && ownsNameAfter(request.resource.data.name))))
        // Coach/Photographe officiel peuvent aussi être attribués/retirés
        // par le Team Leader d'un Team PRO, à n'importe quel compte --
        // pas seulement l'admin. <field>TeamId nomme le Team PRO qui
        // vouche pour ce badge, vérifié ici même (isTeamLeader + teamPro),
        // pas un champ qu'on peut mentir dessus.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coach', 'coachTeamId'])
            && request.resource.data.get('coachTeamId', null) != null
            && isTeamLeader(request.resource.data.coachTeamId)
            && get(/databases/$(database)/documents/teams/$(request.resource.data.coachTeamId)).data.get('teamPro', false) == true)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photographer', 'photographerTeamId'])
            && request.resource.data.get('photographerTeamId', null) != null
            && isTeamLeader(request.resource.data.photographerTeamId)
            && get(/databases/$(database)/documents/teams/$(request.resource.data.photographerTeamId)).data.get('teamPro', false) == true)
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // Pseudo registry (see nameKey above). A claim is create-only, for the
    // caller's own uid and a doc id equal to the lowercased pseudo; the
    // owner can release it (rename / account deletion), only the admin can
    // edit or seed one (legacy riders without an account are seeded by the
    // admin so nobody can squat their name and inherit their chronos).
    match /names/{id} {
      allow read: if verified();
      allow create: if (request.auth != null && request.resource.data.keys().hasOnly(['uid', 'name'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name.lower() == id) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    // Email addresses live here, not on the world-readable users doc --
    // own doc only (no verified() needed: it's written at signup, before
    // the address is confirmed), plus the admin.
    match /userPrivate/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // Everything else requires a verified email to write, so a bot that
    // signs up with a throwaway address can't touch shared data. A chrono
    // can only be created/edited/deleted by its own pilote or the admin --
    // never by another pilote, never by an accompagnant, and a pilote
    // can't reassign one to someone else's name either.
    match /sessions/{id} {
      allow read: if verified();
      // certifiedBy is the event organiser's seal on a chrono -- a pilote
      // (or a team leader entering one for a teammate) can never set or
      // change it on their own write; only the dedicated clause below can.
      allow create: if verified() && (isAdmin() || (request.resource.data.get('certifiedBy', null) == null
        && (ownsChrono(request.resource.data.rider)
            || ownsChronoViaTeam(request.resource.data.rider, request.resource.data.get('teamId', null)))));
      allow update: if verified() && (isAdmin()
        || (request.resource.data.get('certifiedBy', null) == resource.data.get('certifiedBy', null)
            && ((ownsChrono(resource.data.rider) && ownsChrono(request.resource.data.rider))
                || (ownsChronoViaTeam(resource.data.rider, resource.data.get('teamId', null))
                    && ownsChronoViaTeam(request.resource.data.rider, request.resource.data.get('teamId', null)))))
        // Certification -- the linked event's own Team Leader, and only
        // the certifiedBy field, so this can never be used to touch the
        // rider/laps/date of someone else's chrono.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['certifiedBy'])
            && isOrganizerOfLinkedEvent(resource.data.get('eventId', null)))
        // Rename self-heal -- ownsChrono(before) && ownsChrono(after)
        // above can never both hold during an actual rename (myName()
        // only ever resolves to one value at a time), so a pseudo change
        // needs its own proof of ownership: the doc's own uid, unforgeable,
        // same shape as every other collection's canRenameField/
        // canBackfillUid (see saveProfile's groupARenameSpecs).
        || canRenameField(resource, 'rider', 'uid') || canBackfillUid(resource, 'rider', 'uid'));
      allow delete: if verified() && (isAdmin() || ownsChrono(resource.data.rider)
        || ownsChronoViaTeam(resource.data.rider, resource.data.get('teamId', null)));
    }
    // events/{id}.teamId (optional) makes an event a Team Event, "owned"
    // by that Team's leader(s) -- per the brief, a personal/backfilled
    // sortie (no teamId) stays exactly as permissive as before (any
    // verified account, so a new account can rebuild years of history
    // under whatever organizer name it actually rode under). Visibility
    // (public/adherent/membre/follower/ouvert) is a display-layer filter only
    // (see eventsList()), same convention as every other audience field
    // in this app -- read stays open to any signed-in account.
    match /events/{id} {
      allow read: if verified();
      allow create: if verified() && (request.resource.data.get('teamId', null) == null || isTeamLeader(request.resource.data.teamId));
      // A Team Event flagged 'ouvert' also lets any verified account add
      // themselves (only themselves, only an addition) to riders directly
      // -- true self-registration, "sans validation" per the brief; every
      // other visibility tier and every other field stays leader-only.
      // Exact-equality check (old riders + [myName()], in that order) --
      // a size+1-and-myName-present check alone would only prove the net
      // count and that I'm now in there, not that every existing rider
      // survived untouched: a malicious verified account could otherwise
      // swap out anyone else's name in the same write as long as the net
      // size still moved by +1 and its own name was somewhere in the
      // result. concat() pins the result to "exactly the old list, plus
      // me, appended" -- nothing else can move.
      // A rider of the event may also react with one emoji once it's
      // over (reactions.<myName()>, own key only, see onlyOwnKeyChanged)
      // -- the lightweight post-event "likes" ask, deliberately not a
      // free-text comment/photo thread. personalMediaLinks is the same
      // own-key-only shape -- each rider's own photo album link, open to
      // any rider on the roster (not just the Team Leader, unlike the one
      // shared mediaLink field above).
      // A personal event (no teamId) is editable by the pilotes it lists
      // (or by the admin), and anyone may append themselves to its riders
      // -- no longer by any verified account whatsoever.
      allow update: if verified() && (
        (resource.data.get('teamId', null) == null
          && (isAdmin() || myName() in resource.data.get('riders', [])
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riders'])
                  && request.resource.data.riders == resource.data.get('riders', []).concat([myName()]))))
        || isTeamLeader(resource.data.teamId)
        || (resource.data.get('eventVisibility', null) == 'ouvert'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riders'])
            && request.resource.data.riders == resource.data.get('riders', []).concat([myName()]))
        || (myName() in resource.data.get('riders', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && onlyOwnKeyChanged(resource.data.get('reactions', {}), request.resource.data.reactions))
        || (myName() in resource.data.get('riders', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personalMediaLinks'])
            && onlyOwnKeyChanged(resource.data.get('personalMediaLinks', {}), request.resource.data.personalMediaLinks))
        // Mon rôle sur ce roulage (riderRoles.<myName()> = 'accompagnant'),
        // ma clé seulement : un pilote qui vient une fois en accompagnant.
        || (myName() in resource.data.get('riders', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderRoles'])
            && onlyOwnKeyChanged(resource.data.get('riderRoles', {}), request.resource.data.riderRoles))
        // RGPD (droit à l'effacement) : anyone may take themselves off a
        // roulage entirely -- their name out of riders, and only their own
        // key out of the per-rider maps, nothing else touched.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riders', 'riderGroups', 'personalMediaLinks', 'reactions', 'riderBikeNumbers', 'riderRoles'])
            && request.resource.data.get('riders', []) == resource.data.get('riders', []).removeAll([myName()])
            && request.resource.data.get('riderGroups', {}).diff(resource.data.get('riderGroups', {})).affectedKeys().hasOnly([myName()])
            && request.resource.data.get('personalMediaLinks', {}).diff(resource.data.get('personalMediaLinks', {})).affectedKeys().hasOnly([myName()])
            && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myName()])
            && request.resource.data.get('riderBikeNumbers', {}).diff(resource.data.get('riderBikeNumbers', {})).affectedKeys().hasOnly([myName()])
            && request.resource.data.get('riderRoles', {}).diff(resource.data.get('riderRoles', {})).affectedKeys().hasOnly([myName()]))
      );
      // A personal roulage (no team) that only lists me can go with my account.
      allow delete: if verified() && (isAdmin() || (resource.data.get('teamId', null) != null && isTeamLeader(resource.data.teamId))
        || (resource.data.get('teamId', null) == null && resource.data.get('riders', []).removeAll([myName()]).size() == 0));
    }
    // A 'public' Team Event needs the leader's OK to actually join (unlike
    // 'ouvert', which self-registers straight onto the event, see above)
    // -- id = eventId_from so a second request overwrites, same
    // create-then-delete shape as teamJoinRequests; accept is just the
    // leader adding the rider to event.riders themselves (already allowed)
    // then deleting this doc, no "accepted" status needed.
    match /eventJoinRequests/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.from == myName() && request.resource.data.status == 'pending';
      allow delete: if verified() && (
        resource.data.from == myName()
        || isTeamLeader(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.get('teamId', ''))
      );
    }
    // Shared reference data (plan/km/virages/organisateur/horaires
    // habituels/outlineImage) is admin-only to write now -- was open to
    // any verified account, which meant literally anyone could overwrite
    // another circuit's imported plan image, not just tweak a number.
    // Carved out: "drawings"/"outlineDrawings" (the annotation layer any
    // pilote/accompagnant can doodle on top of the shared plan/track
    // outline, see saveAnnotation) stay open -- that's deliberately
    // collaborative, but personal to each account now (one shared base
    // plan, everyone's own marks kept apart instead of overwriting each
    // other) -- each is a map keyed by rider name, own key only, see
    // onlyOwnKeyChanged. Every circuit write is a full-document .set() of
    // the client's whole in-memory entry (see diffCircuits), never a
    // partial update, so affectedKeys() only ever lists fields whose
    // *value* actually changed against the stored doc.
    match /circuits/{id} {
      allow read: if verified();
      // drawingObjects/drawingsBase (and their outline- twins) are the
      // per-account vector layer and its frozen pre-vector backdrop (see
      // saveAnnotation/setupAnnotCanvas in app.js) -- always written
      // alongside their `drawings`/`outlineDrawings` flattened-PNG sibling
      // in the very same call, so both create and update need to accept
      // all three keys of one family together, never just one alone.
      allow create: if isAdmin() || (verified() && (
        (request.resource.data.keys().hasOnly(['drawings', 'drawingObjects', 'drawingsBase', 'name'])
          && request.resource.data.get('drawings', {}).keys().hasOnly([myName()])
          && request.resource.data.get('drawingObjects', {}).keys().hasOnly([myName()])
          && request.resource.data.get('drawingsBase', {}).keys().hasOnly([myName()]))
        || (request.resource.data.keys().hasOnly(['outlineDrawings', 'outlineDrawingObjects', 'outlineDrawingsBase', 'name'])
          && request.resource.data.get('outlineDrawings', {}).keys().hasOnly([myName()])
          && request.resource.data.get('outlineDrawingObjects', {}).keys().hasOnly([myName()])
          && request.resource.data.get('outlineDrawingsBase', {}).keys().hasOnly([myName()]))
      ));
      allow update: if isAdmin() || (verified() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drawings', 'drawingObjects', 'drawingsBase'])
          && onlyOwnKeyChanged(resource.data.get('drawings', {}), request.resource.data.get('drawings', {}))
          && onlyOwnKeyChanged(resource.data.get('drawingObjects', {}), request.resource.data.get('drawingObjects', {}))
          && onlyOwnKeyChanged(resource.data.get('drawingsBase', {}), request.resource.data.get('drawingsBase', {})))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outlineDrawings', 'outlineDrawingObjects', 'outlineDrawingsBase'])
          && onlyOwnKeyChanged(resource.data.get('outlineDrawings', {}), request.resource.data.get('outlineDrawings', {}))
          && onlyOwnKeyChanged(resource.data.get('outlineDrawingObjects', {}), request.resource.data.get('outlineDrawingObjects', {}))
          && onlyOwnKeyChanged(resource.data.get('outlineDrawingsBase', {}), request.resource.data.get('outlineDrawingsBase', {})))
      ));
      allow delete: if isAdmin();
    }
    // A shared roster, not privately owned data -- create/update were
    // already open to any verified account (so a new account can rebuild
    // years of history under whatever name it actually rode under).
    // Delete matches that same permissiveness now: it used to require
    // isAdmin(), which silently broke a self-service pseudo rename (see
    // diffRiders' create-new-name-then-delete-old-name pair, both in the
    // same persist() batch as sessions/events -- if the delete half was
    // ever denied, the WHOLE batch rolled back atomically, leaving the
    // old name stuck forever and blocking anyone from ever reusing it).
    match /riders/{id} {
      allow read: if verified();
      allow create: if verified();
      // Not open to everyone anymore: a pilote's own roster entry only
      // (matched by name, which also covers the old name during a rename
      // -- get() sees the pre-batch profile), or the admin.
      allow update: if verified() && (isAdmin() || resource.data.name == myName() || request.resource.data.name == myName());
      allow delete: if verified() && (isAdmin() || resource.data.name == myName());
    }
    match /settings/{id} {
      allow read: if verified();
      // "Nos partenaires" (Profil -> Aide -> A propos, see savePartners)
      // and featureVisibility (the Météo/Baptêmes-coaching/Location
      // on-off switches, see saveFeatureVisibility) are admin-only content
      // -- were open to any verified account like every other settings
      // doc, which meant literally anyone could deface the club's own
      // partners list or flip the app-wide feature toggles for everyone.
      // The shared equipment checklist template (settings/checklist)
      // stays open to any verified account: adding an item/category from
      // Planning is deliberately collaborative (see renderPlanningChecklist)
      // -- removing one is only gated admin-only client-side, a much
      // lower-stakes gap than partners/featureVisibility since it's
      // trivially recoverable.
      allow write: if verified() && (id == 'checklist' || isAdmin());
    }
    // Friendship is name-keyed, like everything else in this app, and
    // reduced to one collection instead of a `friends` array on each
    // profile -- a request/accept flow needs to write onto the *other*
    // person's side, which users/{userId}'s own-doc-only rule above never
    // allows. A doc's status starts 'pending' and flips to 'accepted' only
    // by the recipient; either side deleting it covers cancel/decline/
    // un-friend alike, so there's no separate "removed" state to model.
    // Chrono saisi par un pote (souvent un accompagnant) pour un pilote :
    // simple proposition, lisible par les deux seulement. Le pilote la
    // valide (status) et crée lui-même la session à son nom ; l'envoyeur
    // peut retirer la sienne.
    match /chronoProposals/{id} {
      allow read: if verified() && (resource.data.from == myName() || resource.data.to == myName());
      allow create: if verified() && request.resource.data.from == myName() && request.resource.data.to != myName()
        && request.resource.data.status == 'pending';
      allow update: if verified() && resource.data.to == myName()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'refused'];
      allow delete: if verified() && (resource.data.from == myName() || resource.data.to == myName());
    }
    match /friendRequests/{id} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.from == myName()
        && request.resource.data.to != myName()
        && request.resource.data.status == 'pending';
      allow update: if verified() && (
        (resource.data.to == myName()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.from == resource.data.from
          && request.resource.data.to == resource.data.to)
        || canRenameField(resource, 'from', 'fromUid') || canBackfillUid(resource, 'from', 'fromUid')
        || canRenameField(resource, 'to', 'toUid') || canBackfillUid(resource, 'to', 'toUid')
      );
      allow delete: if verified() && (isAdmin() || resource.data.from == myName() || resource.data.to == myName());
    }
    // Coaching -- a Pilote or Organisateur (from) requests coaching from a
    // Coach (to, expected to carry the 'coach' badge, but that's only
    // checked client-side: the badge lives on users/{uid} keyed by uid,
    // not name, so a rule here can't cheaply look it up for an arbitrary
    // target the way isTeamLeader() does for teams). Same accept-only-by-
    // recipient shape as friendRequests; once accepted, the coach alone
    // can write 'plan' (their training notes for that pilote) via a
    // narrow update that touches nothing else.
    match /coachRequests/{id} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.from == myName()
        && request.resource.data.to != myName()
        && request.resource.data.status == 'pending';
      // 'awaiting' ('from'|'to', defaults to 'to' for a doc predating this
      // field -- the original accept-only flow always needed the
      // recipient's action) says whose turn it is: only that side may
      // accept the currently proposed slot, or counter-propose a
      // different one (which flips 'awaiting' to the other side, one
      // open proposal at a time rather than two crossing in flight).
      allow update: if verified() && (
        (resource.data.status == 'pending'
          && (resource.data.from == myName() || resource.data.to == myName())
          && resource.data.get('awaiting', 'to') == (resource.data.from == myName() ? 'from' : 'to')
          && (
            // Accept the slot currently set as-is (the default option, or
            // whatever a prior counter-proposal landed on).
            (request.resource.data.status == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            // Or accept one of up to 3 alternative slots the other side
            // originally offered (see slotOptions, a plain array of
            // labels -- sendCoachRequest) instead of the default one.
            || (request.resource.data.status == 'accepted'
                && request.resource.data.slotLabel in resource.data.get('slotOptions', [])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'slotLabel', 'slotStart', 'slotEnd']))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotStart', 'slotEnd', 'slotLabel', 'awaiting'])
                && request.resource.data.awaiting == (resource.data.from == myName() ? 'to' : 'from'))
          ))
        || (resource.data.to == myName() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan']))
        || canRenameField(resource, 'from', 'fromUid') || canBackfillUid(resource, 'from', 'fromUid')
        || canRenameField(resource, 'to', 'toUid') || canBackfillUid(resource, 'to', 'toUid')
      );
      allow delete: if verified() && (isAdmin() || resource.data.from == myName() || resource.data.to == myName());
    }
    // Coach <-> coaché messaging, append-only (see sendCoachMessage) --
    // only the two parties to that accepted coachRequests can read or
    // post into it; the only edit ever allowed is the sender's own name
    // on a rename (see canRenameField/canBackfillUid). Delete is
    // otherwise unreachable (no client-side action for it) except by
    // the admin, for cleanup of stale/orphaned data (see e.g. a renamed
    // account's old-name messages left behind by a rename bug).
    match /coachMessages/{id} {
      // Private 1:1 messaging, unlike the rest of this app's social
      // features -- read is actually restricted to the two parties
      // (via their coachRequests doc), not just a display-layer filter.
      allow read: if verified() && (isAdmin() || isPartyToCoachRequest(resource.data.requestId));
      allow create: if verified() && request.resource.data.from == myName()
        && isPartyToCoachRequest(request.resource.data.requestId);
      allow update: if verified() && (canRenameField(resource, 'from', 'uid') || canBackfillUid(resource, 'from', 'uid'));
      // Own messages can be erased (RGPD).
      allow delete: if verified() && (isAdmin() || resource.data.from == myName());
    }
    // Social feed -- append-only activity log (a new friendship, a new
    // personal record...). Whoever the entry is about writes it themselves
    // (actor == myName()), and it's otherwise never edited or removed
    // client-side -- except a 'record' entry tied to a chrono (sessionId,
    // see writeFeedEvent's caller in onSubmit) that its owner later
    // deletes: removeSession() cleans up the matching feedEvents doc too,
    // so a deleted chrono doesn't leave a permanent "battu son record" in
    // everyone's Journal.
    match /feedEvents/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.actor == myName();
      // Emoji reaction -- reactions.<myName()> only, own key untouched by
      // anyone else (see onlyOwnKeyChanged).
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && onlyOwnKeyChanged(resource.data.get('reactions', {}), request.resource.data.reactions);
      allow delete: if verified() && (isAdmin() || resource.data.actor == myName());
    }
    // One-way follow (for Personnalités, and now Teams too) -- unlike
    // friendRequests, no acceptance needed: the follower alone creates and
    // deletes their own side of it. followeeType distinguishes a person's
    // name from a team id (defaults to 'user' for docs written before
    // Teams were followable) -- the self-follow check only makes sense
    // for a person. A team-type follow also carries a membership tier
    // ('follower', the default, or 'adherent' -- a paying club member of
    // a Team PRO) -- a follower can never self-grant 'adherent' on
    // create (no payment backend here, so that's trust-based and only the
    // Team's own leader can promote/demote it via update).
    // A Team Leader can also create/delete a team-type follow row for
    // anyone directly (grant/revoke "droits de suivi" from the unified
    // member-management panel, see renderTeamMembersManagement) -- always
    // capped to tier 'follower' on create either way, same as a
    // self-follow; only the separate update path above ever sets
    // 'adherent'.
    match /follows/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.get('tier', 'follower') == 'follower' && (
        (request.resource.data.follower == myName()
          && (request.resource.data.get('followeeType', 'user') != 'user' || request.resource.data.followee != myName()))
        || (request.resource.data.get('followeeType', 'user') == 'team' && isTeamLeader(request.resource.data.followee))
      );
      // adherentRequested is the follower's own self-service "I'd like to
      // become an adherent" flag (see requestTeamAdherent) -- they can
      // only ever set it themselves, never clear someone else's or set
      // tier; the leader is the only one who can act on it (accept: tier
      // 'adherent' + adherentRequested false in one write; decline: just
      // clears the flag), from the unified member-management panel.
      allow update: if verified() && (
        (resource.data.followeeType == 'team' && (
          (isTeamLeader(resource.data.followee)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier', 'adherentRequested'])
            && (request.resource.data.tier == 'adherent' || request.resource.data.tier == 'follower'))
          || (resource.data.follower == myName()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adherentRequested']))
        ))
        || canRenameField(resource, 'follower', 'followerUid') || canBackfillUid(resource, 'follower', 'followerUid')
        // followee is a teamId (not a name) for a team-type follow -- only
        // ever rewritten for the person-followed-a-person shape.
        || (resource.data.get('followeeType', 'user') != 'team'
            && (canRenameField(resource, 'followee', 'followeeUid') || canBackfillUid(resource, 'followee', 'followeeUid')))
      );
      allow delete: if verified() && (
        isAdmin()
        || resource.data.follower == myName()
        || (resource.data.followeeType == 'team' && isTeamLeader(resource.data.followee))
        // Someone following me: I can remove it when erasing my account.
        || (resource.data.get('followeeType', 'user') != 'team' && resource.data.followee == myName())
      );
    }
    // Teams (an organisateur's squad of pilotes, or any group of friends
    // riding together) -- the team doc itself is just identity; who's in
    // it and who leads lives in teamMembers below.
    match /teams/{teamId} {
      allow read: if verified();
      // teamPro (the "Team PRO certifié" badge) is admin-only, same
      // integrity guarantee as certified/personality/pro on users/{}: a
      // leader can change every other field (name, visibility,
      // postPolicy...) but never this one themselves.
      // Créer directement en Team PRO est réservé au rôle de profil
      // Organisateur (voir "Je suis" dans Mon profil) -- tout le monde
      // continue de pouvoir créer un Team amateur, seul un Organisateur
      // voit la case Team PRO à la création (voir renderCreateTeamCard).
      // Un Pilote/Accompagnant passe toujours par l'admin après coup.
      allow create: if verified() && request.resource.data.createdBy == myName()
        && (request.resource.data.get('teamPro', false) == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'pilote') == 'organisateur');
      // memberCount is a display-only counter (member tiles/discovery, see
      // renderTeamTile) nudged by whoever's own join/leave changed it --
      // not a security-sensitive field, so any verified account may bump
      // it, same trust level as a like.
      allow update: if verified() && (
        isAdmin()
        || (isTeamLeader(teamId) && request.resource.data.get('teamPro', false) == resource.data.get('teamPro', false))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if verified() && (isAdmin() || isTeamLeader(teamId));
    }
    // One doc per (team, person), id = teamId_name, so isTeamLeader() and
    // membership checks are plain point lookups (rules can't query). A
    // member can be created three ways: the team's own creator bootstraps
    // themselves in as its first leader; anyone accepting their own
    // accepted teamInvite joins as 'member'; or an existing leader adds/
    // promotes anyone directly (invite or not).
    match /teamMembers/{id} {
      allow read: if verified();
      allow create: if verified() && (
        isAdmin()
        || (request.resource.data.name == myName() && request.resource.data.role == 'leader'
            && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == myName())
        || (request.resource.data.name == myName() && request.resource.data.role == 'member'
            && hasAcceptedTeamInvite(request.resource.data.teamId))
        || isTeamLeader(request.resource.data.teamId)
        // Rename self-heal (see saveProfile's migrateTeamMembershipsForRename):
        // this account's own display name change moves its membership to
        // a new id, since ids (and every isTeamLeader()/isTeamMember()
        // lookup) are keyed by name. migratedFromId must point to a real
        // teamMembers doc that's genuinely this same account's -- proven
        // by uid (request.auth.uid, unforgeable), never by the
        // self-reported name -- with the same role and team, so a rename
        // can never grant a role it didn't already hold.
        || (request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.get('migratedFromId', '') != ''
            && exists(/databases/$(database)/documents/teamMembers/$(request.resource.data.migratedFromId))
            && get(/databases/$(database)/documents/teamMembers/$(request.resource.data.migratedFromId)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/teamMembers/$(request.resource.data.migratedFromId)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/teamMembers/$(request.resource.data.migratedFromId)).data.teamId == request.resource.data.teamId)
      );
      // A leader can change anything on a member's doc -- role (Team
      // Leader/Membre) and teamRole (a free-form in-team tag: mécano,
      // assistant, photographe...). Adherent status lives on the
      // matching follows doc instead (see follows below), not here. A
      // member may also self-service-add their own uid (only that field)
      // to a doc that predates uid tracking -- see the sync-time backfill
      // in refreshMyTeamMembershipsSync -- so a *future* rename has an
      // unforgeable owner to migrate from.
      allow update: if verified() && (
        isAdmin()
        || isTeamLeader(resource.data.teamId)
        || (resource.data.name == myName()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
            && !resource.data.keys().hasAny(['uid']))
      );
      allow delete: if verified() && (
        isAdmin() || isTeamLeader(resource.data.teamId) || resource.data.name == myName()
        || resource.data.get('uid', null) == request.auth.uid
      );
    }
    // A non-member asking to join a Team, either as a plain member or
    // straight in as an adherent -- id = teamId_from so a second request
    // overwrites instead of stacking, same shape as teamInvites but
    // initiated by the other side (the requester, not the leader). Accept
    // is the leader's job and happens by creating (or updating) the
    // matching teamMembers doc directly -- isTeamLeader() already lets a
    // leader create/update any member of their own team, so no separate
    // "accepted" status transition needs to live here; declining is just
    // deleting the request.
    match /teamJoinRequests/{id} {
      allow read: if verified();
      allow create: if verified() && (
        (request.resource.data.from == myName()
          && (request.resource.data.kind == 'member' || request.resource.data.kind == 'adherent')
          && request.resource.data.status == 'pending')
        // Id = teamId_from, so a rename needs a new id -- same
        // migratedFromId+uid recreate shape as teamMembers.
        || (request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.get('migratedFromId', '') != ''
            && exists(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.migratedFromId))
            && get(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.migratedFromId)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.migratedFromId)).data.teamId == request.resource.data.teamId)
      );
      allow update: if verified() && canBackfillUid(resource, 'from', 'uid');
      allow delete: if verified() && (
        isAdmin() || resource.data.from == myName() || isTeamLeader(resource.data.teamId)
        || resource.data.get('uid', null) == request.auth.uid
      );
    }
    // A plain, no-strings like -- id = teamId_name, one per (team, person),
    // self-service create/delete only, like followTeam's own follows rows
    // but without any tier or request semantics.
    match /teamLikes/{id} {
      allow read: if verified();
      allow create: if verified() && (
        request.resource.data.name == myName()
        // Id = teamId_name, so a rename needs a new id -- same
        // migratedFromId+uid recreate shape as teamMembers.
        || (request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.get('migratedFromId', '') != ''
            && exists(/databases/$(database)/documents/teamLikes/$(request.resource.data.migratedFromId))
            && get(/databases/$(database)/documents/teamLikes/$(request.resource.data.migratedFromId)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/teamLikes/$(request.resource.data.migratedFromId)).data.teamId == request.resource.data.teamId)
      );
      allow update: if verified() && canBackfillUid(resource, 'name', 'uid');
      allow delete: if verified() && (isAdmin() || resource.data.name == myName() || resource.data.get('uid', null) == request.auth.uid);
    }
    // Id = teamId_to, so a leader can only ever have one pending/accepted
    // invite outstanding per person per team (a second create would just
    // overwrite, not stack) -- same accept-only-by-recipient shape as
    // friendRequests.
    match /teamInvites/{id} {
      allow read: if verified();
      allow create: if verified() && (
        (request.resource.data.from == myName()
          && isTeamLeader(request.resource.data.teamId)
          && request.resource.data.status == 'pending')
        // Rename self-heal for the recipient side -- id = teamId_to, so a
        // renamed "to" needs a new id, same migratedFromId+uid shape as
        // teamMembers (see below): proven by toUid, never by the
        // self-reported name.
        || (request.resource.data.get('toUid', null) == request.auth.uid
            && request.resource.data.get('migratedFromId', '') != ''
            && exists(/databases/$(database)/documents/teamInvites/$(request.resource.data.migratedFromId))
            && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.migratedFromId)).data.toUid == request.auth.uid
            && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.migratedFromId)).data.teamId == request.resource.data.teamId
            && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.migratedFromId)).data.from == request.resource.data.from
            && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.migratedFromId)).data.status == request.resource.data.status)
      );
      allow update: if verified() && (
        (resource.data.to == myName()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.from == resource.data.from
          && request.resource.data.to == resource.data.to)
        || canRenameField(resource, 'from', 'fromUid') || canBackfillUid(resource, 'from', 'fromUid')
        || canBackfillUid(resource, 'to', 'toUid')
      );
      allow delete: if verified() && (
        isAdmin() || resource.data.from == myName() || resource.data.to == myName()
        || resource.data.get('toUid', null) == request.auth.uid || isTeamLeader(resource.data.teamId)
      );
    }
    // Team feed -- announcements, leader-only per the brief ("écrire dans
    // le feed du team" is listed as one of the admin/leader powers).
    match /teamFeed/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.author == myName() && (
        isTeamLeader(request.resource.data.teamId)
        || (isTeamMember(request.resource.data.teamId) && teamPostPolicy(request.resource.data.teamId) == 'members')
      );
      // A poll vote requires actual membership; an emoji reaction doesn't
      // -- reading the feed is already open to any signed-in account (see
      // "allow read" above), so anyone who can see a post (a follower
      // included, not just a member/adherent/leader) can react to it too,
      // own key only. Follower status itself isn't cheaply checkable here
      // (follows docs don't use a deterministic id the way teamMembers
      // does), so this is intentionally opened to any verified() account
      // rather than gated on it. The post's own author may separately
      // edit its text/link (never a poll's question/options -- votes
      // would no longer match what was asked).
      allow update: if verified() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && onlyOwnKeyChanged(resource.data.get('reactions', {}), request.resource.data.reactions))
        || (isTeamMember(resource.data.teamId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && onlyOwnKeyChanged(resource.data.get('votes', {}), request.resource.data.votes))
          || (resource.data.author == myName()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'linkUrl', 'editedAt']))
        ))
        // Rename self-heal, independent of current membership -- an
        // author who's since left the team can still fix their own old
        // posts' byline (proven by authorUid, not by name or membership).
        || canRenameField(resource, 'author', 'authorUid') || canBackfillUid(resource, 'author', 'authorUid')
      );
      allow delete: if verified() && (isAdmin() || resource.data.author == myName() || isTeamLeader(resource.data.teamId));
    }
    // Wall posts -- readable by any signed-in account like everything
    // else here (friendRequests/follows use auto-generated ids, not
    // deterministic ones, so a security rule can't cheaply verify "is
    // author's friend/follower" the way isTeamLeader() does for teams);
    // the audience field is a display-layer choice (see
    // visibleWallPosts), not a server-enforced boundary.
    // Commentaires sous un message du fil : chacun écrit et supprime les
    // siens (l'admin aussi) ; texte de 500 caractères au plus.
    // Réaction (un emoji) sur un élément du fil qui n'est pas un document
    // (roulage, récap, photos) : une ligne par personne, la sienne seulement.
    match /postReactions/{id} {
      allow read: if verified();
      allow create, update: if verified() && request.resource.data.author == myName() && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8;
      allow delete: if verified() && resource.data.author == myName();
    }
    // Audience (impressions, visites de profil) : un document par lecteur,
    // par publication et par jour ; seul l'auteur les lit (statistiques).
    match /postViews/{id} {
      allow read: if verified() && (resource.data.owner == myName() || resource.data.viewer == myName());
      allow create, update: if verified() && request.resource.data.viewer == myName() && request.resource.data.owner != myName();
    }
    match /profileViews/{id} {
      allow read: if verified() && (resource.data.owner == myName() || resource.data.viewer == myName());
      allow create, update: if verified() && request.resource.data.viewer == myName() && request.resource.data.owner != myName();
    }
    match /postComments/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.author == myName()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.postId is string;
      allow delete: if verified() && (resource.data.author == myName() || isAdmin());
      allow update: if verified() && (canRenameField(resource, 'author', 'authorUid') || canBackfillUid(resource, 'author', 'authorUid'));
    }
    match /wallPosts/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.author == myName();
      // Emoji reaction, own key only -- same "anyone who can see it can
      // react to it" reasoning as teamFeed (see there for why this isn't
      // gated on friend/follower status: not cheaply checkable here, and
      // reading the post is already open to any signed-in account above).
      allow update: if verified() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && onlyOwnKeyChanged(resource.data.get('reactions', {}), request.resource.data.reactions))
        || (resource.data.author == myName()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'linkUrl', 'editedAt']))
        || canRenameField(resource, 'author', 'authorUid') || canBackfillUid(resource, 'author', 'authorUid')
      );
      allow delete: if verified() && (resource.data.author == myName() || isAdmin());
    }
    // Free-text broadcasts a Team Leader sends to an event's pilotes
    // ("ADMINISTRATION OUVERTE DE 18H A 20H", "BRIEFING DEMAIN A 8H15"...)
    // -- read is open to any signed-in account like teamFeed/wallPosts
    // (display-layer filtered to the event's own riders + the leader, not
    // server-enforced); only that event's owning Team's leader may post,
    // edit or delete one.
    match /eventAnnouncements/{id} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.from == myName()
        && isTeamLeader(request.resource.data.teamId);
      allow update: if verified() && (
        (isTeamLeader(resource.data.teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']))
        || canRenameField(resource, 'from', 'fromUid') || canBackfillUid(resource, 'from', 'fromUid')
      );
      allow delete: if verified() && (isAdmin() || isTeamLeader(resource.data.teamId));
    }
    // Hôtel/avion/aéroport, personal per (event, account) -- unlike every
    // other event field, the Team orga never fills these in for anyone
    // else. Still only ever writable by its own rider (or admin), but
    // readable too by anyone who follows that rider (an accompagnant's
    // own "Pilotes que je suis", see renderFollowedTravelInfoSection) --
    // "partager les infos de voyage avec les accompagnants" per the brief.
    match /eventTravelInfo/{id} {
      allow read: if verified() && (
        isAdmin() || resource.data.rider == myName()
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('followedRiders', []).hasAny([resource.data.rider])
            && (resource.data.get('uid', null) == null
                || get(/databases/$(database)/documents/users/$(resource.data.uid)).data.get('shareTravelInfo', true) != false))
      );
      allow create: if verified() && (
        request.resource.data.rider == myName()
        // Id = eventId_rider, so a rename needs a new id -- same
        // migratedFromId+uid recreate shape as teamMembers.
        || (request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.get('migratedFromId', '') != ''
            && exists(/databases/$(database)/documents/eventTravelInfo/$(request.resource.data.migratedFromId))
            && get(/databases/$(database)/documents/eventTravelInfo/$(request.resource.data.migratedFromId)).data.uid == request.auth.uid)
      );
      allow update: if verified() && (isAdmin() || resource.data.rider == myName() || canBackfillUid(resource, 'rider', 'uid'));
      allow delete: if verified() && (isAdmin() || resource.data.rider == myName() || resource.data.get('uid', null) == request.auth.uid);
    }
    // "Mes infos de voyage par défaut" (Mon profil) -- a personal template
    // (same shape as eventTravelInfo) that pre-fills a new event's own,
    // still-empty travel info instead of leaving it blank (see
    // renderMyTravelInfoSection). Doc id is the rider's own name, so unlike
    // eventTravelInfo there's no per-event id to reconcile on a rename --
    // strictly self-only, never shared with followers (only the per-event
    // copy a rider actually saves is ever visible to them).
    match /eventTravelInfoDefaults/{id} {
      allow read, write: if verified() && (isAdmin() || id == myName());
    }
    // Retour d'expérience libre envoyé depuis Profil -> Suggestion --
    // write-only for whoever sends it (no edit/delete of one's own once
    // sent), read-only for the admin who reviews them like a shared inbox.
    // Anonymous visitor-language counters (langStats/{2-3 letter code}):
    // anyone, signed in or not, may only add exactly 1 to the total and
    // to at most one source counter -- no other field, no other change.
    // Only the admin reads them (Aide -> Admin).
    function langStatOk(f) {
      return request.resource.data.get(f, 0) == resource.data.get(f, 0)
        || request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1;
    }
    match /langStats/{code} {
      allow read: if isAdmin();
      allow create: if code.matches('^[a-z]{2,3}$')
        && request.resource.data.keys().hasOnly(['count', 'roulage', 'signup'])
        && request.resource.data.count == 1
        && request.resource.data.get('roulage', 0) <= 1
        && request.resource.data.get('signup', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['count', 'roulage', 'signup'])
        && request.resource.data.count == resource.data.count + 1
        && langStatOk('roulage') && langStatOk('signup');
      allow delete: if isAdmin();
    }

    // Public, read-only snapshot of a roulage for the shareable link
    // (?roulage=<eventId>), readable WITHOUT an account. Holds no rider
    // names -- only a participant count. Written by a rider of that event,
    // its Team leader or the admin; id must be the event's own id.
    match /publicRoulages/{id} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.eventId == id
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['eventId', 'circuit', 'dateStart', 'dateEnd', 'organizer', 'bookingUrl', 'liveTimingUrl', 'briefing', 'days', 'going', 'sharedBy', 'updatedAt', 'updatedByUid'])
        && request.resource.data.sharedBy == myName()
        && exists(/databases/$(database)/documents/events/$(id))
        && (isAdmin()
            || myName() in get(/databases/$(database)/documents/events/$(id)).data.get('riders', [])
            || (get(/databases/$(database)/documents/events/$(id)).data.get('teamId', null) != null
                && isTeamLeader(get(/databases/$(database)/documents/events/$(id)).data.teamId)));
      allow delete: if isAdmin();
    }
    // Anonymous usage counters (usageStats/{metric}): any signed-in account
    // may only add exactly 1 to the total and to the current month's
    // counter (m<year>_<month>) -- nothing else. Admin reads them.
    match /usageStats/{metric} {
      function monthKey() { return 'm' + string(request.time.year()) + '_' + string(request.time.month()); }
      allow read: if isAdmin();
      allow create: if request.auth != null && metric.matches('^[a-z0-9_]{1,40}$')
        && request.resource.data.keys().hasOnly(['count', monthKey()])
        && request.resource.data.count == 1 && request.resource.data[monthKey()] == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', monthKey()])
        && request.resource.data.count == resource.data.get('count', 0) + 1
        && request.resource.data[monthKey()] == resource.data.get(monthKey(), 0) + 1;
      allow delete: if isAdmin();
    }
    match /feedback/{id} {
      // Its author can read and erase their own suggestions (RGPD access
      // and erasure); otherwise admin-only, like a shared inbox.
      allow read: if isAdmin() || (request.auth != null && resource.data.authorUid == request.auth.uid);
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author == myName();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }
  }
}
